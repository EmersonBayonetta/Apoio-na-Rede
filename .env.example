# Server only (Vercel Functions). Never prefix these variables with VITE_.
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
# SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY is supplied by the Vercel integration.
